SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=crm.example.com
DB_NAME=sajo_cctv_crm
DB_USER=crm_user
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
TIME_ZONE=Asia/Kolkata
BACKUP_RETENTION_DAYS=30
# Optional dotted Python callable receiving (backup_path, DatabaseBackup instance).
# BACKUP_UPLOAD_HOOK=yourapp.backups.upload
# Optional Fernet key for `backup_database --encrypt` and encrypted restores.
# BACKUP_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=https://crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
